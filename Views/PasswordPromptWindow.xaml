<Window x:Class="PDF_Easy_Loader.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PDF_Easy_Loader.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PasswordPromptViewModel}"
        Title="パスワードの入力" Height="220" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFF7F7F9">

    <StackPanel Margin="20">
        <TextBlock Text="登録済みのパスワードでは開けませんでした。" TextWrapping="Wrap" />
        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Margin="0,8,0,0"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Text="パスワード" Margin="0,16,0,4" FontSize="12" Foreground="#FF6B6B76" />
        <PasswordBox x:Name="PasswordInput" Padding="6,4"
                     PasswordChanged="OnPasswordChanged" />
        <TextBlock Text="※ ここで入力したパスワードは保存されません。"
                   FontSize="11" Foreground="#FF6B6B76" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="キャンセル" Padding="16,4" Margin="0,0,8,0"
                    IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="開く" Padding="16,4" IsDefault="True"
                    Command="{Binding OkCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
